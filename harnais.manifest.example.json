{
  "$schema": "./.claude/harnais.manifest.schema.json",
  "harnais": "2.0",
  "plugins": [
    { "name": "caveman", "marketplace": "caveman", "source": "github:JuliusBrussee/caveman", "ref": "v4.1.0" },
    { "name": "ponytail", "marketplace": "ponytail", "source": "github:DietrichGebert/ponytail", "ref": "v5.3.3" }
  ],
  "skills": [
    {
      "name": "ecc-frontend-patterns",
      "from": "github:affaan-m/ECC",
      "path": "skills/frontend-patterns",
      "ref": "v2.2.3",
      "description": "Use when building or styling a web page or component (React, Next.js, CSS) in this project.",
      "paths": ["src/**/*.tsx", "src/**/*.css"]
    }
  ],
  "optional_hooks": {
    "hard-stop-guard": true,
    "context-watchdog": true,
    "credit-watchdog": true,
    "resume-after-reset": true,
    "graphify-check": false
  },
  "optional_skills": ["security-audit"],
  "optional_agents": []
}
